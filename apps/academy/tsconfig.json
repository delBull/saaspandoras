{
  "extends": "@saasfly/typescript-config/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@saasfly/shared": ["../../packages/shared/src/index.ts"],
      "@saasfly/hermes-core": ["../../packages/hermes-core/src/index.ts"],
      "@saasfly/auth-sdk": ["../../packages/auth-sdk/src/index.ts"],
      "@saasfly/db-core": ["../../packages/db-core/src/index.ts"],
      "@saasfly/db-core/schema": ["../../packages/db-core/src/schema.ts"],
      "@saasfly/nexus-deals-sdk": ["../../packages/nexus-deals-sdk/src/index.ts"],
      "@saasfly/academy-sdk/client": ["../../packages/academy-sdk/src/client.ts"],
      "@saasfly/academy-sdk": ["../../packages/academy-sdk/src/index.ts"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "jsx": "preserve"
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
