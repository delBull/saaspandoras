{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "SKIP_DTS=1 turbo run build --filter=@saasfly/dashboard... --concurrency=1",
  "installCommand": "bun install --no-frozen-lockfile",
  "crons": [
    {
      "path": "/api/v1/internal/cron/reconcile",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/ipfs-repin",
      "schedule": "*/30 * * * *"
    }
  ]
}
