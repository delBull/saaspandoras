interface NexusCommandCenterProps {
  auth: NexusAuthContext;
  initialTour?: string;
  initialRole?: string;
  iframeToken?: string;
  token?: string;
}

interface NexusLink {
  label: string;
  note?: string;
  href: string;
  external?: boolean;
  cap?: string | string[];
  superAdminOnly?: boolean;
}

interface NexusSection {
  id: string;
  title: string;
  description: string;
  icon: React.ComponentType<{ className?: string }>;
  color: string;
  border: string;
  text: string;
  bgAccent: string;
  cap?: string | string[];
  links: NexusLink[];
}

