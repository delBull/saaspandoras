{
  "extends": "@saasfly/typescript-config/base.json",
  "compilerOptions": { "moduleResolution": "bundler",
    "tsBuildInfoFile": ".next/tsconfig.tsbuildinfo",
    "types": [
      "next",
      "next/types/global"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@pandoras/gamification": [
        "../../packages/gamification/src"
      ],
      "@pandoras/gamification/*": [
        "../../packages/gamification/src/*"
      ],
      "@saasfly/shared/thirdweb-client": ["../../packages/shared/src/thirdweb-client.ts"],
      "@saasfly/shared/canonical-capabilities": ["../../packages/shared/src/admin/canonical-capabilities.ts"],
      "@saasfly/shared/utils": ["../../packages/shared/src/utils.ts"],
      "@saasfly/shared/project-utils": ["../../packages/shared/src/project-utils.ts"],
      "@saasfly/shared/phase-utils": ["../../packages/shared/src/phase-utils.ts"],
      "@saasfly/shared/project-status": ["../../packages/shared/src/project-status.ts"],
      "@saasfly/shared": ["../../packages/shared/src/index.ts"], "@saasfly/hermes-core": ["../../packages/hermes-core/src/index.ts"], "@saasfly/auth-sdk": ["../../packages/auth-sdk/src/index.ts"], "@saasfly/ui": [
        "../../packages/ui/src"
      ],
      "@saasfly/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@saasfly/db-core": ["../../packages/db-core/src/index.ts"],
      "@saasfly/db/schema": ["../../packages/db-core/src/index.ts"],
      "@saasfly/db": ["../../packages/db-core/src/index.ts"],
      "@/db": ["../../packages/db-core/src/index.ts"],
      "@/db/schema": ["../../packages/db-core/src/index.ts"],
      "~/db": ["../../packages/db-core/src/index.ts"],
      "~/db/schema": ["../../packages/db-core/src/index.ts"],
      "drizzle-orm": ["../../packages/db-core/node_modules/drizzle-orm"],
      "drizzle-orm/*": ["../../packages/db-core/node_modules/drizzle-orm/*"],
      "@saasfly/api": [
        "../../packages/api/src"
      ],
      "@pandoras/protocol-deployer": [
        "../../packages/protocol-deployer/src"
      ],
      "@pandoras/protocol-deployer/*": [
        "../../packages/protocol-deployer/src/*"
      ],
      "@pandoras/agora-engine": [
        "../../packages/agora-engine/src"
      ],
      "@pandoras/agora-engine/*": [
        "../../packages/agora-engine/src/*"
      ],
      "@pandoras/core-webhooks": [
        "../../packages/core-webhooks/src"
      ],
      "@pandoras/core-webhooks/*": [
        "../../packages/core-webhooks/src/*"
      ],
      "@pandoras/display-engine": [
        "../../packages/display-engine/src"
      ],
      "@pandoras/display-engine/*": [
        "../../packages/display-engine/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts/legacy",
    "scratch"
  ]
}