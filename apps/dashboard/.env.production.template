# ──────────────────────────────────────────────────────────────────────────────
# Hermes Production Environment Variables Template
# G1 — Production Infrastructure
#
# Copy to .env.production (never commit with real values)
# ──────────────────────────────────────────────────────────────────────────────

# ─── Hermes Runtime ───────────────────────────────────────────────────────────

# Kill switch: set to 'false' to immediately disable all cognitive responses
# without code changes. POST /api/v1/internal/portal/messages/stream returns 503.
HERMES_ENABLED=true

# Reasoning provider selection:
#   'ollama'      → OllamaStreamingProvider (production default, supports streaming)
#   'ollama-sync' → OllamaReasoningProvider (non-streaming, debug only)
#   (unset)       → MockStreamingProvider (development/test)
HERMES_REASONING_PROVIDER=ollama

HERMES_RUNTIME_VERSION=1.0
HERMES_POLICY_VERSION=1.1
HERMES_ENV=production

# ─── Ollama (G2 — Real LLM) ───────────────────────────────────────────────────

# Base URL for Ollama server (no trailing slash)
# For local: http://localhost:11434
# For remote: https://your-ollama-host.example.com
OLLAMA_BASE_URL=http://localhost:11434

# Model to use. Must be pulled on the Ollama server before go-live.
# Recommended for production: llama3.2:3b (fast) or llama3.1:8b (quality)
# Verify with: curl http://localhost:11434/api/tags
OLLAMA_MODEL=llama3.2:3b

# ─── Database (G1 — Infrastructure) ──────────────────────────────────────────

# Use the pooler endpoint for production (avoids cold-start issues)
# Format: postgresql://user:pass@host-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ─── Application ──────────────────────────────────────────────────────────────

NEXTAUTH_URL=https://your-production-domain.com
NEXTAUTH_SECRET=

# ─── Health Check ─────────────────────────────────────────────────────────────
# GET /api/health/hermes
# Returns: { overall: 'healthy'|'degraded'|'unavailable', subsystems: {...} }
# No credentials or tenant data are ever returned.
