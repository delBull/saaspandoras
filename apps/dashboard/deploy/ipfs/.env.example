# 🌐 Pandora's Sovereign IPFS Stack Configuration
# apps/dashboard/deploy/ipfs/.env

# API Key / Bearer Token used by Caddy to authorize Hermes RPC requests
PANDORAS_KUBO_API_KEY=replace_with_strong_random_secret_token_64chars

# Domain Names for Caddy Let's Encrypt TLS
IPFS_GATEWAY_DOMAIN=ipfs.pandoras.finance
IPFS_RPC_DOMAIN=rpc.ipfs.pandoras.finance
