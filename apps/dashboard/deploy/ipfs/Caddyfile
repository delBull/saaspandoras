# 🌐 Pandora's Sovereign IPFS Reverse Proxy (Unified Port for Railway / Cloud)
{
    auto_https off
}

:{$PORT:8080} {
    encode gzip zstd

    # Route 1: Private RPC API (Hermes & Deal Signing Control Plane)
    @rpc {
        header_regexp host Host ^rpc\.
    }
    handle @rpc {
        @unauthorized {
            not header Authorization "Bearer {$PANDORAS_KUBO_API_KEY}"
            not header X-API-Key "{$PANDORAS_KUBO_API_KEY}"
        }
        respond @unauthorized "Unauthorized Sovereign RPC Access" 401

        reverse_proxy 127.0.0.1:5001 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Route 2: Public Read-Only Gateway (Web3 Frontends & IPFS Downloads)
    handle {
        header {
            Access-Control-Allow-Origin *
            Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
            Access-Control-Allow-Headers "Range"
            X-Content-Type-Options "nosniff"
        }

        @options {
            method OPTIONS
        }
        respond @options 204

        reverse_proxy 127.0.0.1:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}
