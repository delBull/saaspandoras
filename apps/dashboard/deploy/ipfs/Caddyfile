# 🌐 Pandora's Sovereign IPFS Reverse Proxy (Multi-Port Listener for Railway)
{
    auto_https off
}

:80, :8080, :5000, :{$PORT:8080} {
    encode gzip zstd

    # Route 1: Private RPC API (rpc.ipfs.pandoras.finance)
    @rpc {
        header_regexp host Host ^rpc\.
    }
    handle @rpc {
        @unauthorized {
            not header Authorization "Bearer {$PANDORAS_KUBO_API_KEY}"
            not header X-API-Key "{$PANDORAS_KUBO_API_KEY}"
        }
        respond @unauthorized "Unauthorized Sovereign RPC Access" 401

        reverse_proxy 127.0.0.1:5001
    }

    # Route 2: Public Read-Only Gateway (ipfs.pandoras.finance)
    handle {
        header {
            Access-Control-Allow-Origin *
            Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
            Access-Control-Allow-Headers "Range"
            X-Content-Type-Options "nosniff"
        }

        @options {
            method OPTIONS
        }
        respond @options 204

        reverse_proxy 127.0.0.1:8080
    }
}
